# PNS — Environment Configuration
# ─────────────────────────────────────────────
# Generate fresh VAPID keys with:
#   npm run generate-keys
#
# Then copy this file to .env and fill in your values.

PUBLIC_VAPID_KEY=YOUR_PUBLIC_VAPID_KEY_HERE
PRIVATE_VAPID_KEY=YOUR_PRIVATE_VAPID_KEY_HERE
VAPID_CONTACT=mailto:admin@example.com
DEMO_PORT=3000
